# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Security & Secrets
JWT_SECRET=your_jwt_secret_key_here
ADMIN_KEY=your_admin_key_here

# Email Configuration (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Google OAuth (Calendar & Google Sheets integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://<your-backend-app-name>.onrender.com/api/auth/google/callback

# Frontend URL (For OAuth redirects and CORS)
FRONTEND_URL=https://<your-frontend-app-name>.onrender.com

# Server Port (Render sets this automatically, default: 5000)
PORT=5000
